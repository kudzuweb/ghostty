# Ghostty fork sleep guard: lets the app flip the system sleep flag without a password.
# Install: sudo install -o root -g wheel -m 0440 fork/sudoers.d/ghostty-sleep-guard /etc/sudoers.d/ghostty-sleep-guard
# See FORK.md, Sleep guard.
USERNAME ALL=(root) NOPASSWD: /usr/bin/pmset -a disablesleep 1, /usr/bin/pmset -a disablesleep 0
